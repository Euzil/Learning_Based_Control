      </geometry>
    </collision>
    <inertial>
      <mass value="2.35"/>
      <origin rpy="0 1.57079632679 -1.57079632679" xyz="0.0 -0.005 0.0"/>
      <inertia ixx="0.00475357" ixy="0.0" ixz="0.0" iyy="0.00475357" iyz="0.0" izz="0.0077855"/>
    </inertial>
  </link>

  <joint name="right_wheel_joint" type="continuous">
    <axis xyz="0 1 0"/>

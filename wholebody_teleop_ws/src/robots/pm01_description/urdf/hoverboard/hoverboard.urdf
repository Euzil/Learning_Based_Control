<?xml version="1.0" encoding="utf-8"?>
<robot name="hoverboard">
  <link name="base_link">
    <visual>
      <geometry>
        <cylinder length="0.006" radius="0.0175"/>
      </geometry>
      <origin rpy="0.0 1.57079632679 -1.57079632679" xyz="0.0 0.0 0.0"/>
    </visual>
    <collision>
      <origin rpy="0.0 1.57079632679 -1.57079632679" xyz="0.0 0.0 0.0"/>
      <geometry>
        <cylinder length="0.006" radius="0.0175"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.00577"/>
      <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
      <inertia ixx="4.59e-07" ixy="0.0" ixz="0.0" iyy="8.83e-07" iyz="0.0" izz="4.59e-07"/>
    </inertial>
  </link>

  <link name="right_plate_link">
    <visual>
      <origin rpy="0 0 -1.57079632679" xyz="0 0.1105 0"/>
      <geometry>
        <mesh filename="../meshes/right_plate_vis.stl"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.221 0.186 0.08"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="2.0"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <inertia ixx="0.00920683" ixy="0.0" ixz="0.0" iyy="0.00683267" iyz="0.0" izz="0.0139062"/>
    </inertial>
  </link>

  <joint name="right_plate_joint" type="revolute">
    <axis xyz="0 1 0"/>
    <parent link="base_link"/>
    <child link="right_plate_link"/>
    <origin rpy="0 0 0" xyz="0.0 -0.1135 0.0"/>
    <limit effort="0" lower="-0.05" upper="0.05" velocity="0.1"/>
    <dynamics damping="1.0" friction="0.1"/>
  </joint>

  <link name="right_wheel_link">
    <visual>

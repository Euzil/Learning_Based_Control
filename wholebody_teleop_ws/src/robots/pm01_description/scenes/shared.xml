<mujoco model="go2 scene">

  <!-- simulation solver settings -->
  <option iterations="50" timestep="0.001" solver="PGS" gravity="0 0 -9.81" />
  <compiler angle="radian" meshdir="../meshes" assetdir="../assets" eulerseq="zyx" autolimits="true" />

  <!-- config -->
  <default>
    <motor ctrllimited="true" />
    <equality solref="0.001 2" />
    <default class="visualgeom">
      <geom rgba="0.75294 0.75294 0.75294 1" condim="1" contype="0" conaffinity="0" density="0" group="1" />
    </default>
    <default class="collisiongeom">
      <geom rgba="0.75294 0.75294 0.75294 1" group="3" />
    </default>
  </default>

  <!-- skin plugin: see mujoco_skin package -->
  <extension>
    <plugin plugin="mujoco.sensor.skin" />
    <plugin plugin="mujoco.sensor.ray_caster" />
    <plugin plugin="mujoco.sensor.ray_camera" />
  </extension>

  <!-- world assets -->
  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <!-- camera -->
  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-130" elevation="-20"/>
  </visual>

</mujoco>